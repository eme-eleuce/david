# Copiar a .env.local y completar con los valores del proyecto Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# URL de la app (local ahora; luego tu dominio, sin barra final)
# Usada en el correo de “recuperar contraseña”
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Supabase Dashboard → Authentication → URL Configuration
# ---------------------------------------------------------------------------
# Site URL (local):     http://localhost:3000
# Site URL (prod):      https://tu-dominio.com
#
# Redirect URLs (añade todas las que uses):
#   http://localhost:3000/auth/callback
#   http://localhost:3000/restablecer
#   https://tu-dominio.com/auth/callback
#   https://tu-dominio.com/restablecer
#
# Tip: abre el enlace del correo en el MISMO navegador donde pediste el reset
# (PKCE). No mezcles localhost con 127.0.0.1.
